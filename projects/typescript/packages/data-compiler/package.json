{
    "name": "@neonschedule1/data-compiler",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "imports": {
        "#data-compiler/*": {
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc -p tsconfig.json",
        "test": "vitest run --config ../../vitest.config.mts --project data-compiler",
        "normalize": "node dist/cli.js",
        "validate:convex": "node dist/convex-validation-cli.js"
    },
    "dependencies": {
        "@neonschedule1/core": "workspace:*",
        "arktype": "2.2.3"
    }
}
