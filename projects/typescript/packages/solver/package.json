    "verify": "node dist/verify-cli.js",
    "native": "node dist/native-cli.js",
    "precompute": "node dist/precompute-cli.js",
    "precompute:package": "node dist/precompute-package-cli.js",
    "precompute:refresh": "node dist/precompute-refresh-cli.js",
    "precompute:verify": "node dist/precompute-verify-cli.js"
  },
  "dependencies": {
    "@neonschedule1/core": "workspace:*"
  }
